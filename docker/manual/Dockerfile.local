# 本地一键构建（含 Iconify 按需图标支持）
# 直接编译仓库内已生成的源码，无需先构建 flare-base 基础镜像。
FROM golang:1.26-alpine AS builder
WORKDIR /app
ENV CGO_ENABLED=0
ENV GOPROXY=https://goproxy.cn,direct
COPY . .
# 若存在 vendor/ 则离线构建，否则按 GOPROXY 拉取依赖
RUN go build -ldflags "-w -s" -o flare main.go

FROM alpine:3.20
COPY --from=builder /app/flare /bin/flare
ENV TZ=Asia/Shanghai
WORKDIR /app
CMD ["flare"]
